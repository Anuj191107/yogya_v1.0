@import url('https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Playfair+Display:ital,wght@0,500;0,600;0,700;1,500;1,600&display=swap');
:root{--ink:#f7f3e9;--dark:#132a28;--deep:#0c1e1c;--orange:#e7a15f;--muted:#b9c4bc;--paper:#f4f1e9;--green:#244b41}
*{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;font-family:'DM Sans',sans-serif;background:var(--paper);color:#182c29}button,a{font:inherit}button{cursor:pointer}a{color:inherit;text-decoration:none}.hero{position:relative;min-height:780px;height:100svh;max-height:1050px;background:#152d2d url('/yogyahero.png') center 40%/cover no-repeat;color:var(--ink);overflow:hidden}.hero-shade{position:absolute;inset:0;background:linear-gradient(90deg,rgba(9,25,24,.83) 0%,rgba(9,25,24,.58) 42%,rgba(9,25,24,.04) 100%),linear-gradient(0deg,rgba(9,25,24,.45),transparent 42%);pointer-events:none}.topbar{position:relative;z-index:2;display:flex;align-items:center;justify-content:space-between;padding:28px 6.2%;border-bottom:1px solid #ffffff2b}.brand{display:inline-flex;align-items:center;gap:9px;font-size:25px;font-weight:700;letter-spacing:-1.3px;color:white}.brand-mark{display:grid;place-items:center;width:33px;height:33px;border-radius:50%;background:var(--orange);color:#172a25;font-family:'Playfair Display',serif;font-size:22px}.brand-dot{color:var(--orange);margin-left:-9px}.nav-links{display:flex;align-items:center;gap:32px;font-size:13px;color:#f7f3e9dd}.nav-links a:hover,.text-link:hover{color:var(--orange)}.nav-cta,.outline-btn{background:transparent;border:1px solid #ffffff80;color:white;border-radius:3px;padding:11px 17px;font-size:12px}.hero-content{position:relative;z-index:1;padding:clamp(85px,12vh,145px) 10% 100px;max-width:930px}.eyebrow,.section-kicker{font-size:10px;letter-spacing:2.1px;font-weight:700;color:var(--orange)}.pulse{display:inline-block;width:7px;height:7px;border-radius:50%;background:#a9c99b;margin-right:9px;box-shadow:0 0 0 4px #a9c99b24}.hero h1{font-size:clamp(50px,6.4vw,88px);line-height:1.02;letter-spacing:-3.8px;font-weight:500;margin:25px 0}.hero h1 em,.intro h2 em,.ecosystem h2 em{font-family:'Playfair Display',serif;font-weight:500;color:var(--orange)}.hero-copy{font-size:15px;line-height:1.9;color:#f4f0e3d9;max-width:470px}.hero-actions{display:flex;align-items:center;gap:28px;margin-top:31px}.primary-btn{background:var(--orange);color:#182c29;border:1px solid var(--orange);padding:14px 20px;border-radius:3px;font-size:12px;font-weight:700;transition:.2s}.primary-btn:hover{background:#f1ba80;transform:translateY(-1px)}.primary-btn:disabled{opacity:.6;cursor:wait}.primary-btn span{margin-left:18px}.text-link{font-size:12px;color:#f4f0e3d9}.text-link span{margin-left:8px}.hero-foot{position:absolute;top:calc(100% + 80px);left:10%;right:8%;display:flex;justify-content:space-between;color:#f4f0e39c;font-size:10px;letter-spacing:.4px}.hero-index{position:absolute;z-index:1;right:6%;bottom:42px;font-size:10px;letter-spacing:2px;color:#ffffffa8}.section-wrap{padding:105px 10%}.intro{background:var(--paper)}.intro-grid,.ecosystem-heading{display:grid;grid-template-columns:1fr 1fr;gap:60px;align-items:end;margin-top:22px}.intro h2,.ecosystem h2{font-size:clamp(42px,5vw,62px);letter-spacing:-2.5px;line-height:1.05;font-weight:500;margin:0}.intro h2 em,.ecosystem h2 em{color:#b8753e}.intro-grid>p,.ecosystem-heading>p{max-width:440px;font-size:14px;line-height:1.9;color:#65716a;margin:0 0 5px}.feature-row{display:grid;grid-template-columns:repeat(3,1fr);gap:24px;margin-top:70px}.feature-row article{border-top:1px solid #c8c9bd;padding-top:22px}.feature-icon{display:grid;place-items:center;width:35px;height:35px;background:#e7e2d5;border-radius:50%;color:#9b6138;font-size:20px}.feature-row h3{font-size:16px;margin:20px 0 8px}.feature-row p{font-size:12px;line-height:1.8;color:#727b73;max-width:250px}.ecosystem{background:#e8e6dc}.ecosystem-heading{margin-bottom:38px}.role-grid{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:12px}.role-card{position:relative;text-align:left;display:flex;flex-direction:column;min-height:220px;padding:20px 16px;background:#f7f5ee;border:1px solid #d8d7cd;border-radius:4px;color:#203630;transition:.2s}.role-card:hover{border-color:#b8753e;transform:translateY(-4px);box-shadow:0 12px 30px #213c2910}.role-icon{font-size:25px}.role-name{font-size:15px;font-weight:700;margin-top:24px}.role-detail{font-size:11px;line-height:1.6;color:#707970;margin-top:8px}.role-arrow{position:absolute;right:15px;top:17px;color:#b8753e}.footer{display:flex;justify-content:space-between;align-items:center;gap:15px;padding:28px 6%;background:#142b27;color:#b9c4bc;font-size:10px}.footer .brand{font-size:20px}.footer .brand-mark{width:28px;height:28px;font-size:18px}.dashboard{min-height:100vh;background:#f3f2ec}.dash-nav{height:75px;padding:0 6%;display:flex;align-items:center;gap:24px;background:#142b27}.dark-brand{margin-right:auto}.demo-pill{font-size:9px;letter-spacing:1.4px;border:1px solid #ffffff45;border-radius:30px;color:#d3dfd5;padding:8px 12px}.dash-body{max-width:1200px;margin:auto;padding:65px 5%}.dash-welcome{display:flex;align-items:center;justify-content:space-between;gap:20px}.dash-welcome h1{font-size:clamp(30px,4vw,46px);letter-spacing:-1.5px;margin:12px 0 8px;font-weight:600}.dash-welcome p{color:#707970;font-size:13px}.dash-welcome .section-kicker{color:#a56b3d}.stat-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:16px;margin:35px 0}.stat-card,.panel{background:#fffefa;border:1px solid #e2e0d6;border-radius:5px;padding:23px}.stat-card span,.stat-card small{display:block;font-size:11px;color:#707970}.stat-card strong{display:block;font-size:34px;margin:13px 0 8px;letter-spacing:-1px}.stat-card small{font-size:10px;color:#9aa097}.dash-columns{display:grid;grid-template-columns:1.25fr .75fr;gap:16px}.panel-head{display:flex;justify-content:space-between;align-items:center;gap:10px}.panel h2{font-size:17px;margin:0 0 18px}.panel-head>span{font-size:10px;color:#a56b3d}.task-row{display:flex;align-items:center;gap:14px;width:100%;padding:18px 0;border:0;border-top:1px solid #e9e7df;background:transparent;text-align:left;font-size:12px;color:#34443b}.task-num{font-size:10px;color:#b8753e}.task-arrow{margin-left:auto;color:#b8753e}.sarthi-panel{background:#e8e6dc}.sarthi-orb{display:grid;place-items:center;width:48px;height:48px;border-radius:50%;background:#234a40;color:#f0b477;font-size:25px;margin-bottom:22px}.sarthi-panel .section-kicker{font-size:9px;color:#a56b3d}.sarthi-panel h2{font-family:'Playfair Display',serif;font-size:30px;font-weight:500;margin:8px 0}.sarthi-panel>p{font-size:12px;line-height:1.8;color:#68746b}.secondary-btn,.outline-btn{padding:11px 15px;border:1px solid #8c988d;background:transparent;color:#274239;border-radius:3px;font-size:11px}.chat-form{display:flex;flex-direction:column;gap:10px;margin-top:20px}.chat-form label{font-size:11px;font-weight:700}.chat-form textarea{width:100%;border:1px solid #d1d0c6;border-radius:3px;background:#fffefa;padding:12px;font:12px 'DM Sans',sans-serif;resize:vertical}.ai-answer{white-space:pre-wrap;background:#fffefa;padding:13px;border-radius:3px;font-size:12px;line-height:1.8;max-height:280px;overflow:auto}.notice{font-size:11px;line-height:1.6;color:#9b6138}.disclaimer{text-align:center;color:#92988e;font-size:10px;margin-top:25px}
@media(max-width:850px){.hero{min-height:720px;background-position:58% center}.hero-content{padding-left:7%;padding-right:7%}.hero-shade{background:linear-gradient(90deg,rgba(9,25,24,.82),rgba(9,25,24,.35)),linear-gradient(0deg,rgba(9,25,24,.45),transparent)}.hero-foot{left:7%;right:7%;top:calc(100% + 55px);gap:15px}.section-wrap{padding:75px 7%}.role-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.role-card{min-height:180px}.dash-columns{grid-template-columns:1fr}.nav-links{gap:15px}.intro-grid,.ecosystem-heading{gap:25px}}
@media(max-width:560px){.hero{min-height:700px;height:94svh}.topbar{padding:20px 6%}.nav-links>a{display:none}.nav-cta{padding:9px 12px}.hero h1{font-size:54px;letter-spacing:-2.5px}.hero-content{padding-top:115px}.hero-copy{font-size:13px}.hero-foot{font-size:9px;top:calc(100% + 42px)}.intro-grid,.ecosystem-heading{grid-template-columns:1fr;gap:18px}.intro h2,.ecosystem h2{font-size:48px}.feature-row{grid-template-columns:1fr;gap:15px;margin-top:40px}.feature-row article{padding:18px 0}.feature-row h3{margin-top:12px}.role-grid{gap:9px}.role-card{padding:15px;min-height:190px}.footer{flex-wrap:wrap}.footer>span:last-child{display:none}.dash-nav{padding:0 5%;gap:10px}.demo-pill{display:none}.dash-body{padding:40px 5%}.dash-welcome{align-items:flex-start;flex-direction:column}.dash-welcome .primary-btn{width:100%}.stat-grid{gap:8px}.stat-card{padding:14px 11px}.stat-card strong{font-size:27px}.stat-card span{min-height:26px;line-height:1.4}.stat-card small{font-size:9px}.panel{padding:18px}}
